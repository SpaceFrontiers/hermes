+/// Exact interpolation within one bounded codec record. The scalar i128
+/// formula and writer remain independent; descending slopes truncate toward
+/// zero by subtracting the same unsigned quotient sequence.
+struct LinearProgression {
+    value: u64,
+    step: u64,
+    remainder: u64,
+    remainder_step: u64,
+    denominator: u64,
+    direction: u64,
+}
+
+impl LinearProgression {
+    fn new(first: u64, last: u64, len: usize, start: usize) -> Self {
+        debug_assert!(len > 0 && len <= BLOCKWISE_LINEAR_BLOCK_SIZE && start < len);
+        let denominator = len.saturating_sub(1).max(1) as u64;
+        let delta = first.abs_diff(last);
+        let quotient = delta / denominator;
+        let remainder_step = delta % denominator;
+        // start and remainder_step are bounded by the 512-value record size;
+        // quotient * start cannot exceed delta at a valid starting position.
+        let remainder_product = remainder_step * start as u64;
+        let magnitude = quotient * start as u64 + remainder_product / denominator;
+        let direction = if last >= first { 1u64 } else { u64::MAX };
+        let signed = |value: u64| {
+            if last >= first {
+                value
+            } else {
+                value.wrapping_neg()
+            }
+        };
+        Self {
+            value: first.wrapping_add(signed(magnitude)),
+            step: signed(quotient),
+            remainder: remainder_product % denominator,
+            remainder_step,
+            denominator,
+            direction,
+        }
+    }
+
+    #[inline]
+    fn next(&mut self) -> u64 {
+        let value = self.value;
+        self.remainder += self.remainder_step;
+        let carry = u64::from(self.remainder >= self.denominator);
+        self.remainder -= carry * self.denominator;
+        // Advancing beyond the last output may wrap; no extra value is exposed.
+        self.value = self
+            .value
+            .wrapping_add(self.step)
+            .wrapping_add(carry * self.direction);
+        value
+    }
+}
